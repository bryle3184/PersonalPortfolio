# Optional override for the contact form's Formspree endpoint.
# The portfolio's form (meaenwpj) is built into the app, so no setup is needed.
# Set this only to send inquiries to a different form. Paste just the ID
# (e.g. meaenwpj); the full https://formspree.io/f/<id> URL also works.
VITE_FORMSPREE_ID=meaenwpj
